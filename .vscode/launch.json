{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: the checks",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tests/test_study.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
