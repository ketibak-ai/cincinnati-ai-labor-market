{
  "// why": "Opening this folder in VS Code should show the study, not the plumbing.",
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/~$*": true
  },
  "files.associations": { "*.md": "markdown" },
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "python.analysis.extraPaths": ["scripts"],
  "editor.rulers": [96],
  "[python]": { "editor.tabSize": 4, "editor.insertSpaces": true },
  "markdown.preview.breaks": false
}
